# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OpenRouter powers ingredient extraction. Free models are available.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here


# Your public site URL. Used for canonical links and social preview cards.
# Without it, links you share render bare. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://cartify.example.com


# ---------------------------------------------------------------------------
# Affiliate earnings (all optional)
#
# Everything below is optional. With nothing set the app works exactly the
# same, and shopper links simply go out untracked, earning nothing.
#
# Two mechanisms, because affiliate programmes work in two different ways:
#
#   1. AMAZON TAG  — Amazon accepts your Associates ID as a URL parameter.
#   2. DEEP LINK TEMPLATE — every other retailer here is reached through an
#      affiliate network (Awin, Impact, Rakuten, Cuelinks...). The network
#      gives you a redirect URL. Paste it whole and mark where the destination
#      goes with {URL}. Nothing else to wire up.
#
# After changing any NEXT_PUBLIC_ value you must redeploy: Next.js bakes them
# into the build rather than reading them at runtime.
# ---------------------------------------------------------------------------

# --- Amazon Associates -----------------------------------------------------
# Each Amazon region is a SEPARATE programme with its own tag. An amazon.in tag
# earns nothing on amazon.com. Sign up per region you serve.
#   India: https://affiliate-program.amazon.in
#   US:    https://affiliate-program.amazon.com
#   UK:    https://affiliate-program.amazon.co.uk
# NEXT_PUBLIC_AMAZON_TAG_IN=yourtag-21
# NEXT_PUBLIC_AMAZON_TAG_US=yourtag-20
# NEXT_PUBLIC_AMAZON_TAG_UK=yourtag-21

# Legacy name, still honoured for India so existing deployments keep working.
# NEXT_PUBLIC_AMAZON_TAG=yourtag-21

# --- Network deep links ----------------------------------------------------
# Paste the deep link your affiliate network generated, with {URL} marking the
# destination. Example shape for Awin:
#   https://www.awin1.com/cread.php?awinmid=1234&awinaffid=5678&ued={URL}
# Example shape for Impact:
#   https://retailer.xxxxxx.net/c/1234567/890123/4567?u={URL}
#
# US — Instacart, Walmart and Target all run through Impact (impact.com).
# NEXT_PUBLIC_AFFILIATE_INSTACART=https://instacart.xxxxxx.net/c/.../?u={URL}
# NEXT_PUBLIC_AFFILIATE_WALMART=https://walmart.xxxxxx.net/c/.../?u={URL}
# NEXT_PUBLIC_AFFILIATE_TARGET=https://target.xxxxxx.net/c/.../?u={URL}
#
# UK — Tesco, Sainsbury's and Ocado run through Awin (awin.com).
# NEXT_PUBLIC_AFFILIATE_TESCO=https://www.awin1.com/cread.php?awinmid=...&awinaffid=...&ued={URL}
# NEXT_PUBLIC_AFFILIATE_SAINSBURYS=https://www.awin1.com/cread.php?awinmid=...&awinaffid=...&ued={URL}
# NEXT_PUBLIC_AFFILIATE_OCADO=https://www.awin1.com/cread.php?awinmid=...&awinaffid=...&ued={URL}
#
# Fallback applied to any store without its own template above. Useful if you
# work with a single cashback network that covers many retailers.
# NEXT_PUBLIC_AFFILIATE_TEMPLATE=https://your-redirect.example/?url={URL}

# NOTE ON INDIA: Swiggy Instamart and Blinkit operate no public affiliate
# programme, so their links are deliberately left clean. If you hold a cashback
# network account (Cuelinks, EarnKaro) that covers them, set the fallback
# template above and it applies to those stores too.


# ---------------------------------------------------------------------------
# Google AdSense (optional)
#
# Ads render only when the publisher ID AND the slot ID for a position are both
# set. Create each unit in AdSense under Ads > By ad unit and copy its numeric
# slot ID here. Approval is required first — see DEPLOYMENT_AND_MONETIZATION.md.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_BANNER_TOP=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_BANNER_BOTTOM=0000000000


# ---------------------------------------------------------------------------
# Marketing toolkit (optional, Founder bundle only)
# ---------------------------------------------------------------------------
# Google AI Studio key, used for Achernar voiceover generation.
# Get a free key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
