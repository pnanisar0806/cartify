{
  "name": "cartify",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"const fs=require('fs'); if (fs.existsSync('.next')) fs.rmSync('.next', {recursive:true, force:true}); console.log('Cleaned .next cache');\"",
    "build": "next build",

    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "git:status": "git status",
    "git:add": "git add -A",
    "git:sync": "git add -A && git commit -m \"fix: resolve start reel button deactivation, add per-script audio caching and update CTA to description\" && git push origin main",
    "git:push": "git push origin main"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "openai": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
